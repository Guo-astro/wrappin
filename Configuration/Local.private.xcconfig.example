// Copy this file to Local.private.xcconfig and fill in only the values needed
// for your own build. Local.private.xcconfig is ignored by Git.
DEVELOPMENT_TEAM = YOUR-APPLE-DEVELOPMENT-TEAM-ID
WRAPPIN_BUNDLE_IDENTIFIER = com.example.wrappin
// Optional: override if your tunnel signing profiles use another App ID.
// WRAPPIN_TUNNEL_BUNDLE_IDENTIFIER = com.example.wrappin.selfsigned
WRAPPIN_TELEMETRY_APP_ID = YOUR-TELEMETRYDECK-APP-ID
WRAPPIN_TELEMETRY_NAMESPACE = your.namespace
// Optional: enables overseas place search. The key ships inside the app.
WRAPPIN_GEOAPIFY_API_KEY = YOUR-GEOAPIFY-API-KEY
