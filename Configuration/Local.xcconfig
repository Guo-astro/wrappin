// Safe public defaults. A checkout builds without analytics and without using
// the repository owner's Apple development team.
DEVELOPMENT_TEAM =
WRAPPIN_BUNDLE_IDENTIFIER = com.suversal.wrappin
WRAPPIN_TUNNEL_BUNDLE_IDENTIFIER = $(WRAPPIN_BUNDLE_IDENTIFIER).selfsigned
WRAPPIN_TELEMETRY_APP_ID =
WRAPPIN_TELEMETRY_NAMESPACE =
// Overseas place search is hidden unless a Geoapify API key is configured.
WRAPPIN_GEOAPIFY_API_KEY =

#include "Version.xcconfig"
#include? "Local.private.xcconfig"
